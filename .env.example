# Copy to .env and fill in. Used only by the docker-compose (non-HA) path.
# On Home Assistant these values go into the add-on's Configuration tab instead.

BOT_TOKEN=123456:your-bot-token-from-BotFather
API_ID=1234567
API_HASH=your_api_hash_from_my_telegram_org

# Comma-separated numeric Telegram user ids of the bot's owner(s) — they can use
# it and approve other people. Leave empty for first-owner mode (the first person
# who messages the bot becomes its owner).
ALLOWED_USER_IDS=

# true = a stranger who messages the bot can ask an owner for access, who allows
# or denies them with a button. false = everyone else is silently refused.
ALLOW_ACCESS_REQUESTS=true

# best = best MP4-compatible quality, fast = best available up to 720p
DEFAULT_FORMAT=best
